# AWS Region (should be us-east-1 for Organizations management account)
aws_region = "us-east-1"

# Schedule for daily monitoring (cron format in UTC)
# Default: 8 AM UTC daily (cron(0 8 * * ? *))
# Examples:
# - 3 AM UTC: cron(0 3 * * ? *)
# - Every 12 hours: rate(12 hours)
schedule_expression = "cron(0 8 * * ? *)"

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
# Email addresses to receive notifications
# These email addresses must be verified in AWS SES for the region
email_recipients = [
  "ops-team@example.com",
  "security-team@example.com"
]

# Email address to send from (must be verified in AWS SES)
sender_email = "aws-monitor@example.com"

# ============================================================================
# SERVICE CONTROL POLICY (SCP) CONFIGURATION
# ============================================================================
# Enable/disable automatic SCP policy management
# - true: Automatically detects new services and updates SCP policy
# - false: Email alerts only (no SCP policy changes) - perfect for testing/audit
manage_scp_policy = true

# Name of the Service Control Policy to manage
# Only used when manage_scp_policy = true
# Leave as default "blacklist" or customize for your SCP name
scp_name = "blacklist"

# Security: Require manual approval before updating SCP
# Only used when manage_scp_policy = true
# - true: Lambda generates SCP preview and waits for manual approval (recommended)
# - false: Lambda automatically updates SCP immediately (not recommended for production)
require_scp_approval = true

# NOTE: To use EMAIL ALERTS ONLY mode (no SCP updates):
# Set: manage_scp_policy = false
# This will:
# ✓ Detect new AWS services
# ✓ Send email notifications
# ✗ NOT modify any SCP policies
# Perfect for: testing, audit, manual SCP management

# ============================================================================
# OPTIONAL CONFIGURATION
# ============================================================================
# Add custom tags to all resources
tags = {
  Project     = "AWS-Service-Monitor"
  Environment = "Management"
  ManagedBy   = "Terraform"
  CostCenter  = "Security"
}
