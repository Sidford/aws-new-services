# AWS Region (should be us-east-1 for Organizations management account)
aws_region = "us-east-1"

# Schedule for daily monitoring (cron format in UTC)
# Default: 8 AM UTC daily (cron(0 8 * * ? *))
# Examples:
# - 3 AM UTC: cron(0 3 * * ? *)
# - Every 12 hours: rate(12 hours)
schedule_expression = "cron(0 8 * * ? *)"

# Name of the Service Control Policy to manage
scp_name = "blacklist"

# Email addresses to receive notifications
# These email addresses must be verified in AWS SES for the region
email_recipients = [
  "ops-team@example.com",
  "security-team@example.com"
]

# Email address to send from (must be verified in AWS SES)
sender_email = "aws-monitor@example.com"

# Optional: Add custom tags
tags = {
  Project     = "AWS-Service-Monitor"
  Environment = "Management"
  ManagedBy   = "Terraform"
  CostCenter  = "Security"
}
